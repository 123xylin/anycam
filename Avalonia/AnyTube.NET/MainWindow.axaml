<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:anycad="clr-namespace:AnyCAD.AvaloniaUI;assembly=AnyCAD.Avalonia.NET"
        x:Class="AnyTubeNet.MainWindow"
        Title="AnyTube.NET"
        Width="1280"
        Height="760"
        MinWidth="960"
        MinHeight="560">

  <Grid ColumnDefinitions="300, 3, *" Margin="7">
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <StackPanel Spacing="10">
          <TextBlock x:Name="FileNameText" Text="未导入文件" Foreground="#526071" TextWrapping="Wrap" />
          <Button x:Name="ImportButton"
                  Content="导入"
                  Margin="0,0,0,8"
                  Padding="12,8"
                  Click="ImportButton_Click" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="10">
          <Grid ColumnDefinitions="*,8,*,8,*">
            <Button x:Name="StartButton"
                    Grid.Column="0"
                    Content="开始"
                    Padding="12,8"
                    Click="StartButton_Click" />
            <Button x:Name="PauseButton"
                    Grid.Column="2"
                    Content="暂停"
                    Padding="12,8"
                    Click="PauseButton_Click" />
            <Button x:Name="StopButton"
                    Grid.Column="4"
                    Content="停止"
                    Padding="12,8"
                    Click="StopButton_Click" />
          </Grid>
          <TextBlock Text="速度" Foreground="#526071" />
          <Slider x:Name="SpeedSlider" Minimum="0.1" Maximum="2" Value="1.0" TickFrequency="0.1" />
        </StackPanel>
    </Grid>

    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
    <anycad:RenderControl x:Name="RenderView" Grid.Column="2" ViewerReady="RenderView_ViewerReady" />
  </Grid>
</Window>
