solid dual_slide_base
  facet normal 0 0 -1
    outer loop
      vertex -300 -250 -20
      vertex 300 250 -20
      vertex 300 -250 -20
    endloop
  endfacet
  facet normal 0 0 -1
    outer loop
      vertex -300 -250 -20
      vertex -300 250 -20
      vertex 300 250 -20
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex -300 -250 20
      vertex 300 -250 20
      vertex 300 250 20
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex -300 -250 20
      vertex 300 250 20
      vertex -300 250 20
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex -300 -250 -20
      vertex 300 -250 -20
      vertex 300 -250 20
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex -300 -250 -20
      vertex 300 -250 20
      vertex -300 -250 20
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex -300 250 -20
      vertex 300 250 20
      vertex 300 250 -20
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex -300 250 -20
      vertex -300 250 20
      vertex 300 250 20
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex -300 -250 -20
      vertex -300 -250 20
      vertex -300 250 20
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex -300 -250 -20
      vertex -300 250 20
      vertex -300 250 -20
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 300 -250 -20
      vertex 300 250 -20
      vertex 300 250 20
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 300 -250 -20
      vertex 300 250 20
      vertex 300 -250 20
    endloop
  endfacet
endsolid dual_slide_base
