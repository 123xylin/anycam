solid dual_slide_slider
  facet normal 0 0 -1
    outer loop
      vertex -60 -50 -40
      vertex 60 50 -40
      vertex 60 -50 -40
    endloop
  endfacet
  facet normal 0 0 -1
    outer loop
      vertex -60 -50 -40
      vertex -60 50 -40
      vertex 60 50 -40
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex -60 -50 40
      vertex 60 -50 40
      vertex 60 50 40
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex -60 -50 40
      vertex 60 50 40
      vertex -60 50 40
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex -60 -50 -40
      vertex 60 -50 -40
      vertex 60 -50 40
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex -60 -50 -40
      vertex 60 -50 40
      vertex -60 -50 40
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex -60 50 -40
      vertex 60 50 40
      vertex 60 50 -40
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex -60 50 -40
      vertex -60 50 40
      vertex 60 50 40
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex -60 -50 -40
      vertex -60 -50 40
      vertex -60 50 40
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex -60 -50 -40
      vertex -60 50 40
      vertex -60 50 -40
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 60 -50 -40
      vertex 60 50 -40
      vertex 60 50 40
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 60 -50 -40
      vertex 60 50 40
      vertex 60 -50 40
    endloop
  endfacet
endsolid dual_slide_slider
