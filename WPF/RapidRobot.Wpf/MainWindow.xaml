                                            <CheckBox Margin="0,12,0,0" IsChecked="True" Content="启用已确认的 Link 碰撞体" />
                                            <CheckBox Margin="0,7,0,0" IsChecked="True" Content="保留当前末端姿态" />
                                             <Button x:Name="PlanPathButton"
                                                     Margin="0,14,0,0"
                                                     Height="42"
                                                     Style="{StaticResource PrimaryButtonStyle}"
                                                     Content="计算无碰撞路径" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" Background="#F59E0B" CornerRadius="4" VerticalAlignment="Center" />
                                                     <TextBlock x:Name="PlanStatusText"
                                                                Text="等待规划"
                                                                Margin="7,0,0,0"
                                                                Style="{StaticResource SectionTitleStyle}" />
                                                </StackPanel>
                                                     <TextBlock x:Name="PlanBackendText"
                                                                Text="OMPL / FCL"
                                                                HorizontalAlignment="Right"
                                                                Style="{StaticResource CaptionStyle}" />
                                            </Grid>
                                            <UniformGrid Columns="3">
                                                 <StackPanel>
                                                     <TextBlock Text="路径长度" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                                                     <TextBlock x:Name="PathLengthText"
                                                                Text="—"
                                                                Style="{StaticResource MetricStyle}"
                                                                HorizontalAlignment="Center" />
                                                 </StackPanel>
                                                 <StackPanel>
                                                     <TextBlock Text="预计耗时" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                                                     <TextBlock x:Name="PathDurationText"
                                                                Text="—"
                                                                Style="{StaticResource MetricStyle}"
                                                                HorizontalAlignment="Center" />
                                                 </StackPanel>
                                                 <StackPanel>
                                                     <TextBlock Text="采样节点" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                                                     <TextBlock x:Name="PathSamplesText"
                                                                Text="—"
                                                                Style="{StaticResource MetricStyle}"
                                                                HorizontalAlignment="Center" />
                                                 </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="轨迹播放" Style="{StaticResource SectionTitleStyle}" />
                                                 <TextBlock x:Name="PlaybackTimeText"
                                                            Grid.Column="1"
                                                            Text="0.000 / 0.000 s"
                                                            Style="{StaticResource CaptionStyle}"
                                                            VerticalAlignment="Center" />
                                            </Grid>
                                             <Slider x:Name="PlaybackSlider"
                                                     Margin="0,14,0,8"
                                                     Minimum="0"
                                                     Maximum="1"
                                                     IsEnabled="False" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                 <Button x:Name="PlaybackRestartButton"
                                                         Grid.Column="0"
                                                         Margin="0,0,4,0"
                                                         Style="{StaticResource BaseButtonStyle}"
                                                         Content="回到起点" />
                                                 <Button x:Name="PlaybackPlayButton"
                                                         Grid.Column="1"
                                                         Margin="4,0"
                                                         Style="{StaticResource PrimaryButtonStyle}"
                                                         Content="播放" />
                                                 <Button x:Name="PlaybackStopButton"
                                                         Grid.Column="2"
                                                         Margin="4,0,0,0"
                                                         Style="{StaticResource BaseButtonStyle}"
                                                         Content="停止 / 取消" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="2"
                            Padding="16,0"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="8" Height="8" Background="#22C55E" CornerRadius="4" VerticalAlignment="Center" />
                             <TextBlock x:Name="GlobalStatusText"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Text="安全状态：可操作"
                                       Foreground="#475569"
                                       FontSize="10"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="控制器 1 ms"
                                       Style="{StaticResource CaptionStyle}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#172235">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" />
                    <TextBlock Text="RENDERER READY"
                               Margin="7,0,0,0"
                               Foreground="#9FE8BF"
                               FontFamily="Consolas"
                               FontSize="9"
                               VerticalAlignment="Center" />
                </StackPanel>
                 <TextBlock x:Name="RobotDofText"
                            Grid.Column="1"
                            Margin="22,0,0,0"
                            Text="KR500 · 6 DOF"
                           Foreground="#718096"
                           FontSize="9"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="就绪"
                           Foreground="#8492A6"
                           FontSize="9"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           Text="mm"
                           Foreground="#718096"
                           FontSize="9"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="4"
                           Margin="18,0,0,0"
                           Text="v1.0  ·  WPF UI Prototype"
                           Foreground="#617087"
                           FontSize="9"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
