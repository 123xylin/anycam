                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="58" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="AXIS6" VerticalAlignment="Center" FontSize="11" />
                                                <TextBlock Grid.Column="1" Text="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#475569" FontSize="11" />
                                                <Border Grid.Column="2" Width="50" Height="21" HorizontalAlignment="Right" Background="#EAF8F0" CornerRadius="10">
                                                    <TextBlock Text="已确认" Foreground="#15803D" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
