                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton Grid.Column="0"
                                                              Style="{StaticResource SegmentToggleStyle}"
                                                              IsChecked="True"
                                                              Content="末端目标" />
                                                <ToggleButton Grid.Column="1"
                                                              Margin="4,0,0,0"
                                                              Style="{StaticResource SegmentToggleStyle}"
                                                              Content="关节目标" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#16A34A" VerticalAlignment="Center" />
                                                    <TextBlock Text="起点"
                                                               Margin="7,0,0,0"
                                                               Style="{StaticResource SectionTitleStyle}" />
                                                </StackPanel>
                                                <TextBlock Text="当前姿态"
                                                           HorizontalAlignment="Right"
                                                           Foreground="#16A34A"
                                                           FontSize="10" />
                                            </Grid>
                                            <Border Padding="10" Background="#F8FAFC" CornerRadius="7">
                                                <TextBlock FontFamily="Consolas"
                                                           FontSize="10"
                                                           Foreground="#475569"
                                                           Text="X 1245.000   Y 380.000   Z 1080.000&#10;RX 0.000°   RY −90.000°   RZ 0.000°" />
                                            </Border>
                                             <Button x:Name="UseCurrentPoseButton"
                                                     Margin="0,10,0,0"
                                                     Style="{StaticResource BaseButtonStyle}"
                                                     Content="使用当前机器人姿态"
                                                     Command="{Binding UseCurrentPoseCommand}"
                                                     IsEnabled="{Binding CanInteract}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#2563EB" VerticalAlignment="Center" />
                                                    <TextBlock Text="目标位姿"
                                                               Margin="7,0,0,0"
                                                               Style="{StaticResource SectionTitleStyle}" />
                                                </StackPanel>
                                                <TextBlock Text="世界坐标"
                                                           HorizontalAlignment="Right"
                                                           Style="{StaticResource CaptionStyle}" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                 <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                     <TextBlock Text="X / mm" Style="{StaticResource CaptionStyle}" />
                                                     <TextBox x:Name="PlanTargetXTextBox"
                                                              Margin="0,5,0,0"
                                                              Text="{Binding PlanTargetX, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                 <StackPanel Grid.Column="1" Margin="4,0">
                                                     <TextBlock Text="Y / mm" Style="{StaticResource CaptionStyle}" />
                                                     <TextBox x:Name="PlanTargetYTextBox"
                                                              Margin="0,5,0,0"
                                                              Text="{Binding PlanTargetY, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                 <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                     <TextBlock Text="Z / mm" Style="{StaticResource CaptionStyle}" />
                                                     <TextBox x:Name="PlanTargetZTextBox"
                                                              Margin="0,5,0,0"
                                                              Text="{Binding PlanTargetZ, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                 <TextBox x:Name="PlanTargetRxTextBox"
                                                          Grid.Column="0"
                                                          Margin="0,0,4,0"
                                                          Text="{Binding PlanTargetRx, UpdateSourceTrigger=PropertyChanged}" />
                                                 <TextBox x:Name="PlanTargetRyTextBox"
                                                          Grid.Column="1"
                                                          Margin="4,0"
                                                          Text="{Binding PlanTargetRy, UpdateSourceTrigger=PropertyChanged}" />
                                                 <TextBox x:Name="PlanTargetRzTextBox"
                                                          Grid.Column="2"
                                                          Margin="4,0,0,0"
                                                          Text="{Binding PlanTargetRz, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="规划配置"
                                                       Style="{StaticResource SectionTitleStyle}" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="IK 后端" Style="{StaticResource CaptionStyle}" />
                                                     <ComboBox x:Name="IkBackendComboBox"
                                                               Margin="0,5,0,0"
                                                               ItemsSource="{Binding IkBackendItems}"
                                                               SelectedItem="{Binding SelectedIkBackend}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0">
                                                    <TextBlock Text="规划器" Style="{StaticResource CaptionStyle}" />
                                                     <ComboBox x:Name="PlannerComboBox"
                                                               Margin="0,5,0,0"
                                                               ItemsSource="{Binding PlannerItems}"
                                                               SelectedItem="{Binding SelectedPlanner}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                    <TextBlock Text="碰撞后端" Style="{StaticResource CaptionStyle}" />
                                                     <ComboBox x:Name="CollisionBackendComboBox"
                                                               Margin="0,5,0,0"
                                                               ItemsSource="{Binding CollisionBackendItems}"
                                                               SelectedItem="{Binding SelectedCollisionBackend}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="碰撞采样间隔" Style="{StaticResource CaptionStyle}" />
                                                     <TextBox x:Name="CollisionResolutionTextBox"
                                                              Margin="0,5,0,0"
                                                              Text="{Binding CollisionResolution, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock Text="超时时间" Style="{StaticResource CaptionStyle}" />
                                                     <TextBox x:Name="PlanTimeoutTextBox"
                                                              Margin="0,5,0,0"
                                                              Text="{Binding PlanTimeout, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                            <CheckBox Margin="0,12,0,0" IsChecked="True" Content="启用已确认的 Link 碰撞体" />
                                            <CheckBox Margin="0,7,0,0" IsChecked="True" Content="保留当前末端姿态" />
                                             <Button x:Name="SdkCheckIkButton"
                                                     Margin="0,12,0,0"
                                                     Style="{StaticResource BaseButtonStyle}"
                                                     Content="全末端 IK 检查"
                                                     Command="{Binding CheckAllTipIkCommand}"
                                                     IsEnabled="{Binding CanInteract}" />
                                             <TextBlock x:Name="SdkCheckIkStatusText"
                                                        Margin="0,8,0,0"
                                                        Text="{Binding SdkCheckIkStatusText}"
                                                        TextWrapping="Wrap"
                                                        Style="{StaticResource CaptionStyle}" />
                                             <Border Margin="0,14,0,0"
                                                     Padding="10"
                                                     Background="#F8FAFC"
                                                     CornerRadius="7">
                                                 <StackPanel>
                                                     <Grid Margin="0,0,0,10">
                                                         <TextBlock Text="单关节规划"
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold" />
                                                         <Border HorizontalAlignment="Right"
                                                                 Background="#EAF1FF"
                                                                 CornerRadius="10"
                                                                 Padding="8,4">
                                                             <TextBlock Text="SDK DIRECT"
                                                                        Foreground="#1D4ED8"
                                                                        FontSize="8"
                                                                        FontWeight="SemiBold" />
                                                         </Border>
                                                     </Grid>
                                                     <TextBlock Text="关节" Style="{StaticResource CaptionStyle}" />
                                                     <ComboBox x:Name="SdkJointComboBox"
                                                               Margin="0,5,0,8"
                                                               ItemsSource="{Binding SdkJointItems}"
                                                               SelectedItem="{Binding SelectedSdkJoint}" />
                                                     <Grid>
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="*" />
                                                             <ColumnDefinition Width="*" />
                                                         </Grid.ColumnDefinitions>
                                                         <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                             <TextBlock Text="目标值 (rad / mm)" Style="{StaticResource CaptionStyle}" />
                                                             <TextBox x:Name="SdkGoalTextBox" Margin="0,5,0,0" Text="{Binding SdkGoal, UpdateSourceTrigger=PropertyChanged}" />
                                                         </StackPanel>
                                                         <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                             <TextBlock Text="速度 / 加速度" Style="{StaticResource CaptionStyle}" />
                                                             <Grid Margin="0,5,0,0">
                                                                 <Grid.ColumnDefinitions>
                                                                     <ColumnDefinition Width="*" />
                                                                     <ColumnDefinition Width="*" />
                                                                 </Grid.ColumnDefinitions>
                                                                 <TextBox x:Name="SdkVelocityTextBox"
                                                                          Grid.Column="0"
                                                                          Margin="0,0,3,0"
                                                                          Text="{Binding SdkVelocity, UpdateSourceTrigger=PropertyChanged}" />
                                                                 <TextBox x:Name="SdkAccelerationTextBox"
                                                                          Grid.Column="1"
                                                                          Margin="3,0,0,0"
                                                                          Text="{Binding SdkAcceleration, UpdateSourceTrigger=PropertyChanged}" />
                                                             </Grid>
                                                         </StackPanel>
                                                     </Grid>
                                                     <Button x:Name="SdkJointPlanButton"
                                                             Margin="0,10,0,0"
                                                             Height="36"
                                                             Style="{StaticResource PrimaryButtonStyle}"
                                                             Content="规划单关节轨迹"
                                                             Command="{Binding PlanSingleJointCommand}"
                                                             IsEnabled="{Binding CanInteract}" />
                                                 </StackPanel>
                                             </Border>
                                             <Button x:Name="PlanPathButton"
                                                     Margin="0,14,0,0"
                                                     Height="42"
                                                     Style="{StaticResource PrimaryButtonStyle}"
                                                     Content="计算无碰撞路径"
                                                     Command="{Binding PlanPathCommand}"
                                                     IsEnabled="{Binding CanPlan}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" Background="#F59E0B" CornerRadius="4" VerticalAlignment="Center" />
                                                     <TextBlock x:Name="PlanStatusText"
                                                                Text="{Binding PlanStatusText}"
                                                                Margin="7,0,0,0"
                                                                Style="{StaticResource SectionTitleStyle}" />
                                                </StackPanel>
                                                     <TextBlock x:Name="PlanBackendText"
                                                                Text="{Binding PlanBackendText}"
                                                                HorizontalAlignment="Right"
                                                                Style="{StaticResource CaptionStyle}" />
                                            </Grid>
                                            <UniformGrid Columns="3">
                                                 <StackPanel>
                                                     <TextBlock Text="路径长度" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                                                     <TextBlock x:Name="PathLengthText"
                                                                Text="{Binding PathLengthText}"
                                                                Style="{StaticResource MetricStyle}"
                                                                HorizontalAlignment="Center" />
                                                 </StackPanel>
                                                 <StackPanel>
                                                     <TextBlock Text="预计耗时" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                                                     <TextBlock x:Name="PathDurationText"
                                                                Text="{Binding PathDurationText}"
                                                                Style="{StaticResource MetricStyle}"
                                                                HorizontalAlignment="Center" />
                                                 </StackPanel>
                                                 <StackPanel>
                                                     <TextBlock Text="采样节点" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                                                     <TextBlock x:Name="PathSamplesText"
                                                                Text="{Binding PathSamplesText}"
                                                                Style="{StaticResource MetricStyle}"
                                                                HorizontalAlignment="Center" />
                                                 </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="轨迹播放" Style="{StaticResource SectionTitleStyle}" />
                                                 <TextBlock x:Name="PlaybackTimeText"
                                                            Grid.Column="1"
                                                            Text="{Binding PlaybackTimeText}"
                                                            Style="{StaticResource CaptionStyle}"
                                                            VerticalAlignment="Center" />
                                            </Grid>
                                             <Slider x:Name="PlaybackSlider"
                                                     Margin="0,14,0,8"
                                                     Minimum="0"
                                                     Maximum="{Binding PlaybackMaximum}"
                                                     Value="{Binding PlaybackPosition}"
                                                     IsEnabled="{Binding CanControlPlayback}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                 <Button x:Name="PlaybackRestartButton"
                                                         Grid.Column="0"
                                                         Margin="0,0,4,0"
                                                         Style="{StaticResource BaseButtonStyle}"
                                                         Content="回到起点"
                                                         Command="{Binding PlaybackRestartCommand}"
                                                         IsEnabled="{Binding CanControlPlayback}" />
                                                 <Button x:Name="PlaybackPlayButton"
                                                         Grid.Column="1"
                                                         Margin="4,0"
                                                         Style="{StaticResource PrimaryButtonStyle}"
                                                         Content="{Binding PlaybackPlayText}"
                                                         Command="{Binding PlaybackPlayCommand}"
                                                         IsEnabled="{Binding CanControlPlayback}" />
                                                 <Button x:Name="PlaybackStopButton"
                                                         Grid.Column="2"
                                                         Margin="4,0,0,0"
                                                         Style="{StaticResource BaseButtonStyle}"
                                                         Content="停止 / 取消"
                                                         Command="{Binding PlaybackStopCommand}"
                                                         IsEnabled="{Binding CanStopPlayback}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="2"
                            Padding="16,0"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="8" Height="8" Background="#22C55E" CornerRadius="4" VerticalAlignment="Center" />
                             <TextBlock x:Name="GlobalStatusText"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Text="{Binding GlobalStatusText}"
                                       Foreground="{Binding GlobalStatusBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="控制器 1 ms"
                                       Style="{StaticResource CaptionStyle}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#172235">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" />
                    <TextBlock Text="RENDERER READY"
                               Margin="7,0,0,0"
                               Foreground="#9FE8BF"
                               FontFamily="Consolas"
                               FontSize="9"
                               VerticalAlignment="Center" />
                </StackPanel>
                 <TextBlock x:Name="RobotDofText"
                            Grid.Column="1"
                            Margin="22,0,0,0"
                            Text="{Binding RobotDofText}"
                           Foreground="#718096"
                           FontSize="9"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="就绪"
                           Foreground="#8492A6"
                           FontSize="9"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           Text="mm"
                           Foreground="#718096"
                           FontSize="9"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="4"
                           Margin="18,0,0,0"
                           Text="v1.0  ·  WPF UI Prototype"
                           Foreground="#617087"
                           FontSize="9"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
