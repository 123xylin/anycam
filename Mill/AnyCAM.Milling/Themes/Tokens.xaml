<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 设计令牌：深色主题的颜色与字体基元，界面各处统一从这里取值 -->

    <!-- 外壳与面板 -->
    <SolidColorBrush x:Key="ChromeBrush" Color="#101827" />
    <SolidColorBrush x:Key="ChromeSecondaryBrush" Color="#182235" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C2839" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#16212F" />
    <SolidColorBrush x:Key="ViewerBrush" Color="#16212F" />            <!-- 视口底色（与画布同色，场景更沉稳） -->
    <SolidColorBrush x:Key="BorderBrush" Color="#2A364A" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#253147" />       <!-- 视口外框 -->

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextBrush" Color="#E6EBF2" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#93A1B5" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#223453" />

    <!-- 状态色：绿=已计算、橙=待计算、灰=未生成 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#143524" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A2A10" />
    <SolidColorBrush x:Key="PendingBrush" Color="#64748B" />
    <SolidColorBrush x:Key="PendingSoftBrush" Color="#232D3D" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />

    <!-- 视口浮动层：半透明深色覆盖条 -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#E61A2638" />
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#334158" />

    <!--
        字体：单一字体名。WPF 的 FontFamily 不认 CSS 式的逗号 fallback 列表，
        写成 "Segoe UI, Microsoft YaHei UI" 会被当成一个不存在的字体族，
        再整体回落到默认字体并放大字宽，列宽测量随之失真。
    -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI</FontFamily>

</ResourceDictionary>
